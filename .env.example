GEMINI_API_KEY=your-ai-studio-api-key
# Tested on 3 November 2026; use current Flash-Lite / Flash models if these are unavailable.
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: used once when the primary model is unavailable, rate-limited, out of
# daily quota, timed out or not found. Leave empty to disable the fallback.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GOOGLE_CLOUD_PROJECT=your-billing-project-id
RETAIL_MANAGER_ID=manager_a

# Saved Reports + user memory storage; defaults match the local demo container.
REPORTS_POSTGRES_HOST=127.0.0.1
REPORTS_POSTGRES_PORT=5433
REPORTS_POSTGRES_DATABASE=retail_agent
REPORTS_POSTGRES_USER=retail_agent
REPORTS_POSTGRES_PASSWORD=local-reports-demo
REPORTS_EMBEDDING_MODEL=gemini-embedding-2

# Optional style-only Google Doc. Content refreshes on every accepted question.
# Accepts a document ID or a standard https://docs.google.com/document/d/... URL.
# MVP requires unauthenticated text export (Anyone with the link: Viewer).
# No secrets, PII, business data, tool definitions or runtime variables in this doc.
PERSONA_GOOGLE_DOC_ID=

# Golden Knowledge retrieval (reviewed Question -> SQL -> Report trios).
# Build the index with: uv run python -m retail_agent.golden.ingest
GOLDEN_RETRIEVAL_ENABLED=true
# Cosine-similarity floor for a precedent to reach the prompt. 0.65 = initial
# calibration on golden/eval (30 cases): recall@3 0.96, negative false positives 0.33.
GOLDEN_MIN_SIMILARITY=0.65
# Ingestion writer role (separate from the read-only chat agent); local demo values.
GOLDEN_INGEST_POSTGRES_USER=golden_ingest
GOLDEN_INGEST_POSTGRES_PASSWORD=local-golden-ingest-demo

# Optional local Langfuse dashboard. Traces contain graph state and Gemini I/O.
# No comprehensive PII redaction yet: use demo/non-sensitive inputs only.
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# Optional: model for the answer-evaluation judge (defaults to GEMINI_MODEL).
EVAL_JUDGE_MODEL=
